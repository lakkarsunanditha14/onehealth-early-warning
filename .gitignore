data/raw/
__pycache__/
*.pyc
.DS_Store
_to_delete/

# Intermediates rebuild from the pipeline, so they stay out of the repo — except
# the four files the dashboard reads directly, since GitHub Pages serves it from
# here and a dashboard with no data is a broken demo link.
data/interim/*
!data/interim/districts.geojson
!data/interim/neighbours.json
!data/interim/predictions.json
!data/interim/validation.json

# Static inputs that no script regenerates: the 2019 census extract is a fixed
# table, and both fetch_animal.py and join.py read it. Without it a fresh clone
# (and the weekly refresh job) cannot build the panel.
!data/interim/livestock.csv
